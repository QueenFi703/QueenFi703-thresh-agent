{
  "name": "thresh-agent",
  "version": "1.0.0",
  "description": "Modular self-healing GitHub Actions pipeline system",
  "type": "module",
  "engines": {
    "node": "^20.18.1 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/thresh/app/server.js",
    "dev": "tsx thresh/app/server.ts",
    "action": "tsx thresh/run.ts",
    "test": "npm run test:types && node --import tsx --test thresh/tests/*.test.ts",
    "lint": "tsc --noEmit",
    "test:types": "tsc --project tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "probot": "^14.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  },
  "author": "Sophia Cole (QueenFi703)"
}
